# Server only. Never copy the OpenAI secret to the macOS app.
OPENAI_API_KEY=
# Generate: openssl rand -hex 32. Save the same app token in macOS Advanced settings.
CHUP_TOKEN=
PORT=8787
# Verified against current official documentation; account access still needs a smoke test.
REASONING_MODEL=gpt-5.6-luna

# Encrypted response-cache directory on the trusted backend (default backend/.data).
# CHUP_JOURNAL_DIR=/absolute/protected/path/chup-journal
CHUP_JOURNAL_RETENTION_DAYS=30
